# Copy this file to .env and fill in your local/deployment values.
PORT=5000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=commerceos_crm
DB_USER=postgres
DB_PASSWORD=replace_with_database_password
# Generate a random secret of at least 32 characters.
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
MANAGER_EMAIL=manager@example.com
MANAGER_PASSWORD=replace_with_a_unique_password_at_least_12_chars
# Origins are exact origins, comma-separated. No paths or trailing slash.
FRONTEND_URL=http://localhost:5173
STOREFRONT_URL=http://localhost:5174
ALLOWED_ORIGINS=
